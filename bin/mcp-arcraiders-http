#!/usr/bin/env perl
# PODNAME: mcp-arcraiders-http
# ABSTRACT: HTTP MCP + REST server for ARC Raiders game data

our $VERSION = '0.001';

use strict;
use warnings;
use Mojolicious::Lite -signatures;
BEGIN { push @INC, $ENV{METAFORGE_LIB} if $ENV{METAFORGE_LIB} }
use MCP::ArcRaiders;

my $mcp = MCP::ArcRaiders->new;
my $api = $mcp->api;

# MCP endpoint (for Claude)
any '/mcp' => $mcp->server->to_action;

# Info endpoint
get '/' => sub ($c) {
  $c->render(json => {
    name    => 'ARC Raiders API',
    version => $MCP::ArcRaiders::VERSION,
    source  => { name => $MCP::ArcRaiders::SOURCE_NAME, url => $MCP::ArcRaiders::SOURCE_URL },
    endpoints => {
      mcp  => '/mcp (Claude MCP protocol)',
      rest => {
        items         => 'GET /api/items?search=&limit=',
        item          => 'GET /api/items/:name',
        arcs          => 'GET /api/arcs',
        quests        => 'GET /api/quests?trader=&name=',
        quest         => 'GET /api/quests/:quest',
        traders       => 'GET /api/traders',
        ermal         => 'GET /api/ermal',
        hideout       => 'GET /api/hideout?station=&level=',
        weekly_trials => 'GET /api/weekly-trials?include_all=',
        events        => 'GET /api/events?region=',
        active_events => 'GET /api/events/active?region=',
        maps          => 'GET /api/maps',
        map_data      => 'GET /api/maps/:map?category=&subcategory=&search=',
        requirements  => 'POST /api/requirements',
      },
    },
  });
};

# OpenAPI spec for ChatGPT
get '/openapi.json' => sub ($c) {
  my $base_url = $ENV{OPENAPI_SERVER_URL};
  unless ($base_url) {
    my $proto = $c->req->headers->header('X-Forwarded-Proto') // $c->req->url->base->scheme // 'http';
    my $host = $c->req->headers->header('X-Forwarded-Host') // $c->req->url->base->host_port;
    $base_url = "$proto://$host";
  }
  $base_url =~ s{/$}{};  # Remove trailing slash
  my $region_parameter = { name => 'region', in => 'query', schema => { type => 'string', enum => [@MCP::ArcRaiders::REGIONS] }, description => 'Server region of the schedule (default: europe)' };
  $c->render(json => {
    openapi => '3.1.0',
    info => {
      title       => 'ARC Raiders Game Data API',
      description => "API for ARC Raiders game data - items, ARCs, quests, traders, Ermal, hideout, weekly trials, events, maps. $MCP::ArcRaiders::SOURCE_TEXT",
      version     => $MCP::ArcRaiders::VERSION,
      termsOfService => $MCP::ArcRaiders::SOURCE_URL,
      'x-data-source' => { name => $MCP::ArcRaiders::SOURCE_NAME, url => $MCP::ArcRaiders::SOURCE_URL },
    },
    servers => [{ url => $base_url }],
    paths => {
      '/api/items' => {
        get => {
          operationId => 'searchItems',
          summary     => 'Search for items',
          parameters  => [
            { name => 'search', in => 'query', schema => { type => 'string' }, description => 'Search term' },
            { name => 'limit', in => 'query', schema => { type => 'integer', default => 20 }, description => 'Max results' },
          ],
          responses => { 200 => { description => 'List of items' } },
        },
      },
      '/api/items/{name}' => {
        get => {
          operationId => 'getItemDetails',
          summary     => 'Get item details including crafting components, recycle yield, sellers and usage',
          parameters  => [
            { name => 'name', in => 'path', required => \1, schema => { type => 'string' } },
          ],
          responses => { 200 => { description => 'Item details' } },
        },
      },
      '/api/arcs' => {
        get => {
          operationId => 'getArcs',
          summary     => 'Get ARCs with their loot drops',
          responses   => { 200 => { description => 'List of ARCs' } },
        },
      },
      '/api/quests' => {
        get => {
          operationId => 'getQuests',
          summary     => 'Get an overview of all quests: id, name, trader, XP, number of required items and rewards',
          parameters  => [
            { name => 'trader', in => 'query', schema => { type => 'string' }, description => 'Only this trader\'s quests (exact name)' },
            { name => 'name', in => 'query', schema => { type => 'string' }, description => 'Only quests whose name contains this text' },
          ],
          responses => { 200 => { description => 'List of quest summaries' } },
        },
      },
      '/api/quests/{quest}' => {
        get => {
          operationId => 'getQuestDetails',
          summary     => 'Get one quest in full: description, objectives, items, rewards and manifest',
          parameters  => [
            { name => 'quest', in => 'path', required => \1, schema => { type => 'string' }, description => 'Quest id or exact name' },
          ],
          responses => { 200 => { description => 'The quest' } },
        },
      },
      '/api/traders' => {
        get => {
          operationId => 'getTraders',
          summary     => 'Get traders and their inventory',
          responses   => { 200 => { description => 'List of traders' } },
        },
      },
      '/api/ermal' => {
        get => {
          operationId => 'getErmal',
          summary     => 'Get Ermal\'s offers and permanent services',
          responses   => { 200 => { description => 'Offers and services' } },
        },
      },
      '/api/hideout' => {
        get => {
          operationId => 'getHideout',
          summary     => 'Get the hideout stations and what each upgrade level needs',
          parameters  => [
            { name => 'station', in => 'query', schema => { type => 'string' }, description => 'Station id or name (e.g., weapon-bench, Gunsmith)' },
            { name => 'level', in => 'query', schema => { type => 'integer', minimum => 1 }, description => 'Only this upgrade level' },
          ],
          responses => { 200 => { description => 'Hideout stations with levels' } },
        },
      },
      '/api/weekly-trials' => {
        get => {
          operationId => 'getWeeklyTrials',
          summary     => 'Get the running and coming weekly trials with their time window',
          parameters  => [
            { name => 'include_all', in => 'query', schema => { type => 'boolean', default => \0 }, description => 'Also list the trials that are neither running nor coming' },
          ],
          responses => { 200 => { description => 'Weekly trials and the window' } },
        },
      },
      '/api/events' => {
        get => {
          operationId => 'getEventTimers',
          summary     => 'Get event schedules',
          parameters  => [ $region_parameter ],
          responses   => { 200 => { description => 'List of events with times' } },
        },
      },
      '/api/events/active' => {
        get => {
          operationId => 'getActiveEvents',
          summary     => 'Get currently active events',
          parameters  => [ $region_parameter ],
          responses   => { 200 => { description => 'Active events' } },
        },
      },
      '/api/maps' => {
        get => {
          operationId => 'listMaps',
          summary     => 'List all maps',
          responses   => { 200 => { description => 'List of maps' } },
        },
      },
      '/api/maps/{map}' => {
        get => {
          operationId => 'getMapData',
          summary     => 'Get map markers/POIs filtered by category',
          parameters  => [
            { name => 'map', in => 'path', required => \1, schema => { type => 'string', enum => [$api->maps] } },
            { name => 'category', in => 'query', required => \1, schema => { type => 'string', enum => [qw(arc containers locations events nature quests)] }, description => 'Category filter (required)' },
            { name => 'subcategory', in => 'query', schema => { type => 'string' }, description => 'Subcategory filter (e.g., tick, extraction)' },
            { name => 'search', in => 'query', schema => { type => 'string' }, description => 'Search term for marker names and subcategories' },
          ],
          responses => { 200 => { description => 'Map markers' } },
        },
      },
      '/api/requirements' => {
        post => {
          operationId  => 'calculateRequirements',
          summary      => 'Calculate crafting requirements for items',
          requestBody  => {
            required => \1,
            content  => {
              'application/json' => {
                schema => {
                  type => 'object',
                  properties => {
                    items     => { type => 'array', items => { type => 'object', properties => { item => { type => 'string' }, count => { type => 'integer' } } } },
                    base_only => { type => 'boolean', description => 'Resolve to raw materials only' },
                  },
                },
              },
            },
          },
          responses => { 200 => { description => 'Required materials' } },
        },
      },
    },
  });
};

#
# REST API endpoints
#

get '/api/items' => sub ($c) {
  my %params;
  for my $key (qw(search limit id includeComponents)) {
    my $val = $c->param($key);
    $params{$key} = $val if defined $val;
  }
  $params{limit} //= 20;

  my $items = $api->items(%params);
  my $detailed = $params{includeComponents};
  $c->render(json => [ map { $detailed ? _item_detail($_) : _item_hash($_) } @$items ]);
};

get '/api/items/:name' => sub ($c) {
  my $name = $c->param('name');
  my $items = $api->items(search => $name, limit => 5, includeComponents => 'true');

  return $c->render(json => { error => 'Not found' }, status => 404) unless @$items;

  $c->render(json => [ map { _item_detail($_) } @$items ]);
};

get '/api/arcs' => sub ($c) {
  my $arcs = $api->arcs(includeLoot => 'true');
  $c->render(json => [ map { _arc_hash($_) } @$arcs ]);
};

get '/api/quests' => sub ($c) {
  $c->render(json => $mcp->_quest_overview(trader => $c->param('trader'), name => $c->param('name')));
};

get '/api/quests/:quest' => sub ($c) {
  my $quest = $mcp->_quest_details($c->param('quest'));
  return $c->render(json => { error => 'Not found' }, status => 404) unless $quest;
  $c->render(json => $quest);
};

get '/api/traders' => sub ($c) {
  my $traders = $api->traders;
  $c->render(json => [ map { _trader_hash($_) } @$traders ]);
};

get '/api/ermal' => sub ($c) {
  my $ermal = $mcp->_ermal_result;
  return $c->render(json => { error => 'Not found' }, status => 404) unless $ermal;
  $c->render(json => $ermal);
};

get '/api/hideout' => sub ($c) {
  my $level = $c->param('level');
  return $c->render(json => { error => 'level must be a positive integer' }, status => 400)
    if defined $level && $level !~ /\A[1-9][0-9]*\z/;
  my ($stations, $message) = $mcp->_hideout_result(station => $c->param('station'), level => $level);
  return $c->render(json => { error => $message }, status => 404) unless $stations;
  $c->render(json => $stations);
};

get '/api/weekly-trials' => sub ($c) {
  my $all = $c->param('include_all') // '';
  $c->render(json => $mcp->_weekly_trials_result(include_all => $all !~ /\A(?:|0|false|no)\z/i));
};

# The events of a region; an unknown region would silently answer with europe
sub _region_events ($c) {
  my $region = $c->param('region');
  unless (!defined $region || grep { $_ eq $region } @MCP::ArcRaiders::REGIONS) {
    $c->render(json => { error => 'region must be one of: ' . join(', ', @MCP::ArcRaiders::REGIONS) }, status => 400);
    return undef;
  }
  return $mcp->_events(region => $region);
}

get '/api/events' => sub ($c) {
  my $events = _region_events($c) or return;
  $c->render(json => [ map { _event_hash($_) } @$events ]);
};

get '/api/events/active' => sub ($c) {
  my $events = _region_events($c) or return;
  my @active = grep { $_->is_active_now } @$events;
  $c->render(json => [ map { _event_hash($_) } @active ]);
};

get '/api/maps' => sub ($c) {
  my %names = $api->map_display_names;
  $c->render(json => [ map { { id => $_, name => $names{$_} } } $api->maps ]);
};

get '/api/maps/:map' => sub ($c) {
  my $map = $c->param('map');
  my $category = $c->param('category');
  my $subcategory = $c->param('subcategory');
  my $search = $c->param('search');

  return $c->render(json => { error => 'category parameter is required' }, status => 400) unless $category;

  my $markers = $api->map_data(map => $map);

  return $c->render(json => { error => 'Not found' }, status => 404) unless $markers && @$markers;

  my $filtered = $mcp->_filter_markers($markers, category => $category, subcategory => $subcategory, search => $search);

  return $c->render(json => { error => 'No markers found matching criteria' }, status => 404) unless @$filtered;

  $c->render(json => [ map { _marker_hash($_) } @$filtered ]);
};

post '/api/requirements' => sub ($c) {
  my $data = $c->req->json // {};
  my $items = $data->{items} // [];
  my $base_only = $data->{base_only} // 0;

  my $result;
  if ($base_only) {
    $result = $api->calculate_base_requirements(items => $items);
  } else {
    $result = $api->calculate_requirements(items => $items);
  }

  my @requirements = map {
    { item => $_->{item}->name, id => $_->{item}->id, count => $_->{count}, item_type => $_->{item}->item_type, rarity => $_->{item}->rarity }
  } @{$result->{requirements}};

  $c->render(json => { requirements => \@requirements, missing => $result->{missing} });
};

# Helper functions: the shapers of MCP::ArcRaiders, so MCP and REST answer alike
sub _item_hash ($item)    { $mcp->_item_to_hash($item) }
sub _item_detail ($item)  { $mcp->_item_details_to_hash($item) }
sub _arc_hash ($arc)      { $mcp->_arc_to_hash($arc) }
sub _trader_hash ($trader) { $mcp->_trader_to_hash($trader) }
sub _event_hash ($event)  { $mcp->_event_to_hash($event) }
sub _marker_hash ($marker) { $mcp->_marker_to_hash($marker) }

app->start;
